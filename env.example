# Site URL for sharing and metadata
# For local development, use http://localhost:3000
# For production, use your actual domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible Analytics (optional)
# Set to your Plausible site domain (e.g. lili-in.bio) to enable analytics.
# Leave unset to disable (e.g. local dev). Get your domain from: https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lili-in.bio

