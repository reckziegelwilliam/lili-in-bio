# OpenAI API Key (for text upgrade tool)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Resend API Key (for beta signup emails)
# Get your API key from: https://resend.com/api-keys
# Note: You'll need to verify your domain in Resend before sending emails
# Documentation: https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Site URL for sharing features
# For local development, use http://localhost:3000
# For production, use your actual domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

